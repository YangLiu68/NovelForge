# Copy to .env (repo root or backend/) and adjust. Never commit .env.

# --- Backend -------------------------------------------------------------
# SQLAlchemy URL. Leave empty to use the embedded PostgreSQL 16 + pgvector (pgserver) in
# ./.pgdata — dev machines without Docker only; needs `uv sync --extra localdb`.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://novelforge:novelforge@localhost:5433/novelforge

# Claims below this confidence are kept but left out of the contradiction report.
REPORT_MIN_CONFIDENCE=0.6
LOG_LEVEL=INFO
# JSON list of origins allowed to call the API directly (the Vite dev server proxies /api).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SAMPLES_DIR=/absolute/path/to/samples

# --- Frontend dev server ---------------------------------------------------
NOVELFORGE_API_URL=http://127.0.0.1:8000

# --- Later milestones (not read by any Milestone 1 code) --------------------
# LLM_PROVIDER=mock            # mock | anthropic | openai_compatible | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_PROVIDER=mock      # mock | ollama | openai_compatible | voyage
