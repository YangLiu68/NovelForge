# Copy to .env (repo root or backend/) and adjust. Never commit .env.

# --- Backend -------------------------------------------------------------
# SQLAlchemy URL. Leave empty to use the embedded PostgreSQL 16 + pgvector (pgserver) in
# ./.pgdata — dev machines without Docker only; needs `uv sync --extra localdb`.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://novelforge:novelforge@localhost:5433/novelforge

# Claims below this confidence are kept but left out of the contradiction report.
REPORT_MIN_CONFIDENCE=0.6
LOG_LEVEL=INFO
# JSON list of origins allowed to call the API directly (the Vite dev server proxies /api).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SAMPLES_DIR=/absolute/path/to/samples

# Retrieval. "hash" is a deterministic lexical mock (tests/CI). For real semantic search on CPU:
#   uv sync --extra embeddings   then   EMBEDDER=fastembed  RERANKER=cross-encoder
EMBEDDER=hash
RERANKER=lexical
# EMBEDDER=ollama:nomic-embed-text   (needs a running Ollama server, OLLAMA_URL)
# EMBEDDER=openai:text-embedding-3-small   (needs OPENAI_API_KEY; sends text to a hosted API)
# MODEL_CACHE_DIR=~/.cache/novelforge
# Run the background job worker inside the API process (set false when using `novelforge worker`).
JOBS_IN_PROCESS=true

# --- Frontend dev server ---------------------------------------------------
NOVELFORGE_API_URL=http://127.0.0.1:8000

# --- Language models ---------------------------------------------------------
# LLM: mock (offline, default; sends nothing anywhere) | anthropic[:model] | openrouter:<model>
#      | ollama:<model> | replay:<llm> (answers only from recordings in bench/results/llm-cache)
# With anthropic or openrouter, manuscript text is sent to that service.
# LLM=openrouter:anthropic/claude-opus-5.5
# LLM_EFFORT=medium              # low | medium | high | xhigh | max
# LLM_EXTRACTION=false           # run LLM fact extraction as a background job after each save
# ANTHROPIC_API_KEY=             # for LLM=anthropic (or use `ant auth login`)
# OPENROUTER_API_KEY=            # for LLM=openrouter:<model>
# OPENROUTER_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=                # only for EMBEDDER=openai:<model>
